{
  "name": "tshop",
  "version": "0.1.0",
  "description": "Tshop Studio: one-page custom apparel design tool (2D + 3D)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:php": "php wp-plugins/teeshoop-core/tests/run.php",
    "test:wp": "docker compose -f wp-local/docker-compose.yml run --rm wpcli eval-file wp-content/plugins/teeshoop-core/tests/integration.php",
    "verify:grille": "docker compose -f wp-local/docker-compose.yml run --rm wpcli eval-file wp-content/plugins/teeshoop-core/tests/integration-grille.php",
    "zones:mesurer": "node scripts/zones-mesurer.mjs",
    "verify:achat": "node scripts/achat-shots.mjs",
    "wp:up": "docker compose -f wp-local/docker-compose.yml up -d",
    "wp:down": "docker compose -f wp-local/docker-compose.yml down",
    "wp:cli": "docker compose -f wp-local/docker-compose.yml run --rm wpcli",
    "catalogue": "docker compose -f wp-local/docker-compose.yml run --rm wpcli teeshoop catalogue importer",
    "catalogue:etat": "docker compose -f wp-local/docker-compose.yml run --rm wpcli teeshoop catalogue etat",
    "visuels": "docker compose -f wp-local/docker-compose.yml run --rm -T wpcli eval-file - < scripts/visuels-associe.php",
    "verify:bundle": "node scripts/bundle-guard.mjs",
    "verify:admin-gate": "node scripts/admin-gate-verify.mjs",
    "verify:cache": "node scripts/cache-verify.mjs",
    "verify:csp": "node scripts/csp-verify.mjs",
    "verify:style": "node scripts/style-guard.mjs",
    "verify:wp-e2e": "node scripts/wp-e2e-verify.mjs",
    "verify:sav": "node scripts/sav-verify.mjs",
    "verify:wp-catalogue": "node scripts/wp-catalogue-verify.mjs",
    "verify:invoice": "node scripts/invoice-verify.mjs",
    "verify:nest": "node scripts/nest-verify.mjs",
    "verify:fr": "node scripts/fr-verify.mjs",
    "bench:achats": "node scripts/purchase-bench.mjs",
    "ci": "npm run typecheck && npm run typecheck:worker && npm test && npm run test:php && npm run verify:php && npm run verify:php81 && npm run verify:garments && npm run verify:palette && npm run verify:fonts && npm run verify:hypotheses && node scripts/launch-gate.mjs --depot --ci && npm run verify:couleurs && npm run verify:editeur && npm run verify:style",
    "deploy": "npm run build && npm run verify:bundle && wrangler deploy",
    "gen:garments": "node scripts/gen-garment-data.mjs",
    "verify:php": "node scripts/php-guard.mjs",
    "verify:php81": "php scripts/php81-guard.php",
    "verify:pin": "node scripts/pin-verify.mjs",
    "verify:acces": "node scripts/acces-probe.mjs",
    "verify:hypotheses": "node scripts/hypotheses-guard.mjs",
    "verify:lancement": "node scripts/launch-gate.mjs",
    "verify:garments": "node scripts/gen-garment-data.mjs --check",
    "verify:product": "node scripts/product-shots.mjs",
    "verify:bat": "node scripts/bat-verify.mjs",
    "verify:palette": "node scripts/palette-guard.mjs",
    "verify:fonts": "node scripts/theme-fonts-check.mjs",
    "verify:vitrine": "node scripts/vitrine-verify.mjs",
    "verify:site": "node scripts/site-shots.mjs",
    "bench:theme": "node scripts/theme-bench.mjs",
    "bench:shop": "node scripts/shop-bench.mjs",
    "bench:cwv": "node scripts/cwv-bench.mjs",
    "couleurs:mesurer": "docker compose -f wp-local/docker-compose.yml run --rm -T wpcli teeshoop couleurs mesurer",
    "couleurs:reclasser": "docker compose -f wp-local/docker-compose.yml run --rm -T wpcli teeshoop couleurs reclasser",
    "couleurs:relever": "docker compose -f wp-local/docker-compose.yml run --rm -T wpcli teeshoop couleurs etat --releve > docs/couleurs.json",
    "verify:couleurs": "node scripts/couleurs-guard.mjs",
    "verify:render": "node scripts/render-verify.mjs",
    "verify:mockups": "node scripts/mockup-shots.mjs",
    "bench:frame": "node scripts/frame-bench.mjs",
    "verify:leak": "node scripts/leak-verify.mjs",
    "verify:seo": "node scripts/seo-verify.mjs",
    "verify:consent": "node scripts/consent-verify.mjs",
    "verify:a11y": "node scripts/a11y-verify.mjs",
    "verify:focus": "node scripts/focus-verify.mjs",
    "verify:cors": "node scripts/cors-verify.mjs",
    "build:editeur": "vite build --config vite.editeur.config.ts",
    "verify:editeur": "node scripts/editeur-guard.mjs",
    "verify:editeur-shots": "node scripts/editeur-shots.mjs",
    "verify:editeur-achat": "node scripts/editeur-achat-verify.mjs",
    "verify:vendable": "node scripts/fiche-vendable.mjs",
    "verify:retour": "bash scripts/deploiement-retour-verify.sh"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.2.8",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/bangers": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lobster": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/righteous": "^5.2.7",
    "@fontsource/russo-one": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/special-elite": "^5.2.8",
    "@fontsource/urbanist": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "konva": "^10.3.0",
    "lucide": "^1.24.0",
    "lucide-react": "^1.24.0",
    "lz-string": "^1.5.0",
    "nanoid": "^6.0.0",
    "onnxruntime-web": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "private": true
}
