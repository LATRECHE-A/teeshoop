{
  "name": "tshop",
  "version": "0.1.0",
  "description": "Tshop Studio — one-page custom apparel design tool (2D + 3D)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.2.8",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/bangers": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lobster": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/righteous": "^5.2.7",
    "@fontsource/russo-one": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/special-elite": "^5.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "konva": "^10.3.0",
    "lucide": "^1.24.0",
    "lucide-react": "^1.24.0",
    "lz-string": "^1.5.0",
    "nanoid": "^6.0.0",
    "onnxruntime-web": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "private": true
}
